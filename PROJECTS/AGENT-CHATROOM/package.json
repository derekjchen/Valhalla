{
  "name": "valhalla-chatroom",
  "version": "1.0.0",
  "description": "Agent Chatroom with WebSocket support",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "start": "node server/index.js",
    "dev": "nodemon server/index.js"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "testMatch": ["**/*.test.js"],
    "collectCoverageFrom": ["server/**/*.js", "client/**/*.js"]
  },
  "dependencies": {
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "nodemon": "^3.0.0"
  }
}
